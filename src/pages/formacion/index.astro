---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SubjectCard from "../../components/SubjectCard.astro";
import { academicProgram, subjects } from "../../data/subjects";
import { imageLibrary } from "../../data/site";
---

<BaseLayout
  title="Formación y asignaturas"
  description="Programa académico de ALMA: once asignaturas, 240 horas de formación, 20 horas de prácticas profesionales y una duración estimada de seis meses."
  image={imageLibrary.escuela}
>
  <section class="page-hero">
    <div>
      <p class="eyebrow">Formación / Programa académico</p>
      <h1 class="split-lines">
        <span data-line>Un plan formativo</span>
        <span data-line>para trabajar la imagen con método.</span>
      </h1>
    </div>
    <p>{academicProgram.intro}</p>
  </section>

  <section class="section program-intro">
    <SectionHeading
      eyebrow="Programa"
      title="Asignaturas centrales"
      lead="Once asignaturas con finalidad, contenidos, actividades prácticas, resultados de aprendizaje y profesorado responsable."
      number="01"
    />
    <div class="detail-meta">
      <span>Duración estimada: {academicProgram.duration}</span>
      <span>{academicProgram.trainingHours} horas de formación</span>
      <span>{academicProgram.practiceHours} horas de prácticas</span>
      <span>{academicProgram.totalHours} horas en total</span>
    </div>
    <p>{academicProgram.approach}</p>
    <p>{academicProgram.planningNote}</p>
    <p>{academicProgram.detailNote}</p>
    <div class="subjects-grid">
      {subjects.map((subject) => <SubjectCard subject={subject} />)}
    </div>
  </section>

  <section class="section program-flow">
    <p class="eyebrow">Itinerario formativo</p>
    <ol class="timeline-list">
      <li><span>01</span><p>Formación teórico-práctica: 240 horas.</p></li>
      <li><span>02</span><p>Prácticas profesionales: 20 horas.</p></li>
      <li><span>03</span><p>Posible continuidad hacia oportunidades de agencia o empleo.</p></li>
    </ol>
    <p>{academicProgram.itinerary}</p>
  </section>

  <section class="section detail-grid">
    {academicProgram.sections.map((section) => (
      <article class="detail-panel js-reveal">
        <p class="eyebrow">{section.title}</p>
        <p>{section.description}</p>
        {section.items.length > 0 && (
          <ul class="check-list">
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </article>
    ))}
  </section>

  <CTA
    title="La formación conecta con la agencia."
    text="ALMA prepara perfiles para que puedan presentarse con material, criterio y una lectura profesional del sector."
    href="/agencia"
    label="Ver agencia"
    dark
  />
</BaseLayout>
