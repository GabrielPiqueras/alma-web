---
import { versionedImage } from "../data/imageVersions";

interface Props {
  src: string;
  alt: string;
  ratio?: "portrait" | "landscape" | "square" | "wide";
  class?: string;
  eager?: boolean;
  parallax?: boolean;
  transitionName?: string;
}

const {
  src,
  alt,
  ratio = "portrait",
  class: className = "",
  eager = false,
  parallax = false,
  transitionName
} = Astro.props;

const imageSrc = versionedImage(src);
---

<figure
  class:list={["editorial-image", `ratio-${ratio}`, "reveal-mask", className]}
  style={transitionName ? `view-transition-name:${transitionName}` : undefined}
>
  <img
    src={imageSrc}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    data-parallax={parallax ? "soft" : undefined}
  />
</figure>
