---
import { ViewTransitions } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { versionedImage } from "../data/imageVersions";
import { contact, imageLibrary, siteMeta } from "../data/site";
import "../styles/theme.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pageClass?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title = siteMeta.defaultTitle,
  description = siteMeta.defaultDescription,
  image = imageLibrary.hero,
  pageClass = "",
  jsonLd = []
} = Astro.props;

const pageTitle = title.includes("ALMA") ? title : `${title} | ALMA`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteMeta.url).toString();
const metaImage = versionedImage(image);
const imageUrl = metaImage.startsWith("http") ? metaImage : new URL(metaImage, siteMeta.url).toString();
const schema = [
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "EducationalOrganization"],
    name: siteMeta.defaultTitle,
    url: siteMeta.url,
    email: contact.email,
    telephone: contact.phone,
    description,
    sameAs: [`https://www.instagram.com/${contact.instagram.replace("@", "")}`]
  },
  ...jsonLd
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={siteMeta.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <ViewTransitions fallback="swap" />
    <link rel="stylesheet" href="/theme-live.css" />
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script src="/scripts/site.js" type="module" data-astro-rerun></script>
  </body>
</html>
