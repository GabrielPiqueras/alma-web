---
import { versionedLogo } from "../data/logo";
import { contact, navItems, siteMeta } from "../data/site";

const year = new Date().getFullYear();
const logoSrc = versionedLogo();
---

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a class="brand is-footer" href="/">
        <span class="brand-mark"><img class="brand-logo" src={logoSrc} alt={siteMeta.name} /></span>
        <span class="brand-sub">{siteMeta.descriptor}</span>
      </a>
      <p>{siteMeta.defaultDescription}</p>
    </div>

    <nav class="footer-nav" aria-label="Navegación secundaria">
      <span class="footer-title">Navegación</span>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/portfolio">Portfolio</a>
      <a href="/preguntas-frecuentes">Preguntas frecuentes</a>
    </nav>

    <div class="footer-contact">
      <span class="footer-title">Contacto</span>
      {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
      {contact.phone && <a href={`tel:${contact.phone.replaceAll(" ", "")}`}>{contact.phone}</a>}
      {contact.instagram && <a href={`https://www.instagram.com/${contact.instagram.replace("@", "")}/`} target="_blank" rel="noreferrer">{contact.instagram}</a>}
      {contact.streetAddress && <span>{contact.streetAddress}</span>}
      {(contact.postalCode || contact.city) && <span>{[contact.postalCode, contact.city].filter(Boolean).join(" ")}</span>}
      {(contact.region || contact.country) && <span>{[contact.region, contact.country].filter(Boolean).join(", ")}</span>}
    </div>

    <div class="footer-legal">
      <span class="footer-title">Legal</span>
      <a href="/aviso-legal">Aviso legal</a>
      <a href="/privacidad">Privacidad</a>
      <span>© {year} ALMA</span>
    </div>
  </div>
</footer>
