---
import type { GalleryImage } from "../data/gallery";
import { versionedImage } from "../data/imageVersions";

interface Props {
  images: GalleryImage[];
  dark?: boolean;
}

const { images, dark = false } = Astro.props;
---

<div class:list={["gallery-grid", { "is-dark": dark }, "stagger-list"]}>
  {
    images.map((image) => (
      <figure class:list={["gallery-item", `is-${image.shape}`]}>
        <img src={versionedImage(image.src)} alt={image.alt} loading="lazy" decoding="async" />
        <figcaption>{image.label}</figcaption>
      </figure>
    ))
  }
</div>
