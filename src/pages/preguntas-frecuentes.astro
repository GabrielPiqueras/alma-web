---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { faqs, imageLibrary } from "../data/site";
---

<BaseLayout
  title="Preguntas frecuentes"
  description="Preguntas frecuentes sobre ALMA, su formación, el equipo docente y la colaboración con ESATUR."
  image={imageLibrary.detail}
>
  <section class="page-hero compact-hero">
    <div>
      <p class="eyebrow">Preguntas frecuentes</p>
      <h1 class="split-lines">
        <span data-line>Preguntas frecuentes</span>
      </h1>
    </div>
    <p>Información sobre la formación, el equipo y la continuidad profesional en ALMA.</p>
  </section>

  <section class="section faq-list">
    {faqs.map((faq, index) => (
      <article class="faq-item js-reveal">
        <span>{String(index + 1).padStart(2, "0")}</span>
        <h2>{faq.question}</h2>
        <p>{faq.answer}</p>
      </article>
    ))}
  </section>

  <CTA href="/contacto" label="Resolver una duda" dark />
</BaseLayout>
