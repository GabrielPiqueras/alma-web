---
import { versionedLogo } from "../data/logo";
import { contact, navItems, siteMeta } from "../data/site";

const year = new Date().getFullYear();
const logoSrc = versionedLogo();
---

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a class="brand is-footer" href="/">
        <span class="brand-mark"><img class="brand-logo" src={logoSrc} alt={siteMeta.name} /></span>
        <span class="brand-sub">{siteMeta.descriptor}</span>
      </a>
      <p>{siteMeta.defaultDescription}</p>
    </div>

    <nav class="footer-nav" aria-label="Navegación secundaria">
      <span class="footer-title">Navegación</span>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/portfolio">Portfolio</a>
      <a href="/preguntas-frecuentes">Preguntas frecuentes</a>
    </nav>

    <div class="footer-contact">
      <span class="footer-title">Contacto demo</span>
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href={`tel:${contact.phone.replaceAll(" ", "")}`}>{contact.phone}</a>
      <span>{contact.instagram}</span>
      <span>{contact.city}</span>
    </div>

    <div class="footer-legal">
      <span class="footer-title">Legal</span>
      <a href="/aviso-legal">Aviso legal</a>
      <a href="/privacidad">Privacidad</a>
      <span>© {year} ALMA</span>
    </div>
  </div>
</footer>
