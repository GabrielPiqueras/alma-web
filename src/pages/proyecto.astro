---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import EditorialImage from "../components/EditorialImage.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { collaborator, founder, imageLibrary } from "../data/site";
---

<BaseLayout
  title="Historia, filosofía y fundadora"
  description="La historia de ALMA contada por Eliana Herrero, su fundadora y directora, y la colaboración ALMA × ESATUR."
  image={founder.image}
>
  <section class="page-hero">
    <div>
      <p class="eyebrow">Proyecto / Filosofía</p>
      <h1 class="split-lines">
        <span data-line>Una escuela para aprender</span>
        <span data-line>a ocupar una imagen con intención.</span>
      </h1>
    </div>
    <p>{founder.vision}</p>
  </section>

  <section class="section founder-section">
    <EditorialImage src={founder.image} alt="Retrato de Eliana Herrero, fundadora y directora de ALMA" ratio="portrait" parallax />
    <div class="founder-copy js-reveal">
      <p class="eyebrow">Fundadora y directora</p>
      <h2>{founder.name}</h2>
      <p>{founder.role}</p>
      <p>{founder.bio}</p>
      <blockquote>{founder.vision}</blockquote>
    </div>
  </section>

  <section class="section profile-body">
    <div class="quote-panel js-reveal">
      <p class="eyebrow">Eliana Herrero</p>
      <blockquote>Así nació ALMA.</blockquote>
    </div>
    <div class="experience-panel stacked-copy js-reveal">
      <p class="eyebrow">Mi historia</p>
      {founder.story.slice(1).map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section project-values">
    <SectionHeading
      eyebrow="Filosofía"
      title="La imagen como oficio, | no como superficie"
      lead="El proyecto se apoya en una idea sencilla: una persona puede aprender a moverse mejor ante la mirada profesional sin perder naturalidad."
      number="01"
    />
    <div class="method-cards stagger-list">
      <article>
        <span>01</span>
        <h3>Presencia</h3>
        <p>Entrenar cómo estar en cámara, pasarela, sala y conversación profesional.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Criterio</h3>
        <p>Leer una propuesta visual y tomar decisiones de imagen con coherencia.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Profesionalidad</h3>
        <p>Entender tiempos, códigos, preparación y relación con equipos creativos.</p>
      </article>
    </div>
  </section>

  <section class="section two-column reversed">
    <div class="stacked-copy js-reveal">
      <p class="eyebrow">{collaborator.label}</p>
      <h2>{collaborator.title}</h2>
      {collaborator.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <EditorialImage src={imageLibrary.project} alt="Retrato editorial de proyecto ALMA" ratio="portrait" parallax />
  </section>

  <CTA
    title="Tu esencia, tu imagen, tu profesión."
    text="Conoce la formación de ALMA y consulta cómo comenzar tu recorrido."
    href="/contacto"
    label="Solicitar información"
  />
</BaseLayout>
