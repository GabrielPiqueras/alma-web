---
import type { Teacher } from "../data/teachers";
import { versionedImage } from "../data/imageVersions";

interface Props {
  teacher: Teacher;
  featured?: boolean;
}

const { teacher, featured = false } = Astro.props;
const teacherImage = versionedImage(teacher.image);
---

<article class:list={["teacher-card", { "is-featured": featured }, "js-reveal"]}>
  <a href={`/equipo/${teacher.slug}`} class="teacher-card-link" aria-label={`Ver ficha de ${teacher.name}`}>
    <div
      class="teacher-media reveal-mask"
      style={`view-transition-name:teacher-image-${teacher.slug}`}
    >
      <img src={teacherImage} alt={teacher.alt} loading="lazy" decoding="async" />
    </div>
    <div class="teacher-body">
      <p>{teacher.role}</p>
      <h3 style={`view-transition-name:teacher-name-${teacher.slug}`}>{teacher.name}</h3>
      <span>{teacher.bio}</span>
      <span class="text-link">Ficha <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>
